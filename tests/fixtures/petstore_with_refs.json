{
  "openapi": "3.0.3",
  "info": {
    "title": "Petstore (refs)",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/pets": {
      "get": {
        "operationId": "listPets",
        "summary": "List all pets",
        "parameters": [
          {
            "$ref": "#/components/parameters/LimitParam"
          }
        ]
      }
    }
  },
  "components": {
    "parameters": {
      "LimitParam": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer"
        },
        "description": "Max items to return"
      }
    }
  }
}